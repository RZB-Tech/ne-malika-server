# Приложение
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Разрешённые источники запросов через запятую. В production обязателен —
# без него старт падает: открывать CORS всем при credentials нельзя.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5450/nemalika

# Redis — кэш публичной выдачи. Необязателен: без него приложение ходит в БД напрямую.
# В проде — redis://redis:6379, см. docker-compose.prod.yml
REDIS_URL=redis://localhost:6379

# Groq — ИИ-проверка товаров. Без ключа проверка не запускается,
# товары публикуются сразу. Выключить можно и из админки: Настройки → ИИ-проверка.
# Модель менять с оглядкой: изображения на Groq принимает только qwen3.6-27b,
# остальные отвечают "content must be a string" и проверка фото отвалится.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI — только генерация фотографий товара в админке (модерацию делает Groq).
# Без ключа кнопка генерации отвечает 503, остальное работает.
# Размеры до 4K (3840x2160) умеет только gpt-image-2; у gpt-image-1.5 их три:
# 1024x1024, 1024x1536, 1536x1024 — на ней высокие разрешения отвалятся.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# Дешёвая модель с распознаванием картинок — пишет промпт по фотографии товара.
# Отдельно от рисующей: работа простая, платить как за генерацию незачем.
OPENAI_VISION_MODEL=gpt-5-mini

# JWT
JWT_ACCESS_SECRET=changeme-access-secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_REFRESH_TTL=30d

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_TTL_SEC=86400
TELEGRAM_WEBHOOK_URL=            # публичный HTTPS-адрес, напр. https://api.nemalika.uz/api/v1/bot/webhook
TELEGRAM_WEBHOOK_SECRET=         # секрет для заголовка X-Telegram-Bot-Api-Secret-Token

# S3
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=nemalika
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=https://nemalika.s3.example.com
