# Приложение
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Разрешённые источники запросов через запятую. В production обязателен —
# без него старт падает: открывать CORS всем при credentials нельзя.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5450/nemalika

# Redis — кэш публичной выдачи. Необязателен: без него приложение ходит в БД напрямую.
# В проде — redis://redis:6379, см. docker-compose.prod.yml
REDIS_URL=redis://localhost:6379

# OpenRouter — ИИ-проверка товаров и составление промпта по фотографии.
# Без ключа обе функции выключаются, товары публикуются без проверки.
OPENROUTER_API_KEY=
# Модерация: нужен разбор фото и связный вердикт в JSON.
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Промпт по фотографии — работа простая, модель подешевле.
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
# Автозаполнение карточки по фотографиям: описание и характеристики за продавца.
# Модель должна и видеть фото, и разбирать надписи на корпусе — дешёвая vision
# на этой работе путает модели и дописывает несуществующие характеристики.
OPENROUTER_AUTOFILL_MODEL=openai/gpt-4.1-mini
# Рисование: идёт в отдельный Images API OpenRouter, там же размер и качество.
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
# ИИ-сравнение товаров. Покупателю оно бесплатно, значит платим за него мы —
# поэтому самая дешёвая модель с поддержкой JSON. Без ключа кнопка не работает.
OPENROUTER_COMPARE_MODEL=openai/gpt-4.1-nano


# JWT
JWT_ACCESS_SECRET=changeme-access-secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_REFRESH_TTL=30d

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_TTL_SEC=86400
TELEGRAM_WEBHOOK_URL=            # публичный HTTPS-адрес, напр. https://api.nemalika.uz/api/v1/bot/webhook
TELEGRAM_WEBHOOK_SECRET=         # секрет для заголовка X-Telegram-Bot-Api-Secret-Token

# S3
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=nemalika
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=https://nemalika.s3.example.com

# Web push в браузер. Пара генерируется один раз:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Без ключей канал выключается: подписаться нельзя, рассылка уходит только в Telegram.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nemalika.uz

# Click — оплата подписки магазина (docs.click.uz).
# Признак «Click включён» — CLICK_SERVICE_ID: он и в подписи колбэка, и в адресе
# кассы. Пока он пуст, ручка «оплатить» отвечает 503, а всё остальное работает —
# подписку можно выдать вручную из админки.
# CLICK_SECRET_KEY обязателен вместе с CLICK_SERVICE_ID: без него проверка
# подписи отвергнет любой колбэк, и оплата пропадёт молча.
#
# Всё, что ниже, — ровно те четыре значения, которые Click выдаёт при
# подключении услуги. Секрет среди них ОДИН: им и подписываются колбэки
# SHOP API, и считается заголовок Auth у Merchant API.
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
# Пользователь кабинета — вторая половина заголовка Auth у Merchant API,
# то есть возврата уже списанных денег, если выдать подписку не получилось.
# В production обязателен вместе с ключами выше: брать деньги, не умея их
# вернуть, нельзя. Это идентификатор, а не секрет.
CLICK_MERCHANT_USER_ID=
CLICK_MERCHANT_API_URL=https://api.click.uz/v2/merchant
# Таймаут возврата, мс (минимум 1000). Возврат вызывается из обработчика
# Complete, который Click ждёт ограниченное время и при молчании повторяет.
CLICK_REVERSAL_TIMEOUT_MS=5000
# Куда Click вернёт плательщика после кассы. Пусто — оставит у себя.
CLICK_RETURN_URL=https://nemalika.uz/seller/subscription
# Адрес колбэка, который надо прописать в кабинете Click:
#   https://api.nemalika.uz/api/v1/subscriptions/click/callback

# Прайс подписки в сумах. Тариф определяется ПО СУММЕ платежа — Click не
# передаёт, за что заплатили. Поэтому три числа обязаны быть различны;
# совпадение ловится при старте и роняет приложение.
# Пустое значение — не ноль, а «взять умолчание из configuration.ts».
SUBSCRIPTION_PRICE_START_UZS=65000
SUBSCRIPTION_PRICE_PRO_UZS=130000
SUBSCRIPTION_PRICE_MAX_UZS=260000
# Символическая сумма для проверки кассы живыми деньгами. Подписки не даёт
# вовсе: доказывает, что подпись сходится, Prepare и Complete доходят и строка
# в журнале появляется. Принимается, только пока администратор держит окно
# открытым на конкретный магазин (кнопка «Тестовая оплата» в /admin/subscriptions,
# окно живёт 30 минут и закрывается на первой же успешной оплате).
# Совпадение с ценой тарифа ловится при старте: иначе настоящая оплата этого
# тарифа уходила бы в ветку проверки и не выдавала бы ничего.
SUBSCRIPTION_TEST_PRICE_UZS=1000
