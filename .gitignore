# compiled output
/dist
/node_modules
/build
/backup/
*.tsbuildinfo

# Пакетный менеджер здесь только pnpm — им ставит и Dockerfile, и CI. Чужой
# lock-файл от случайного `npm i` разъедется с pnpm-lock и однажды соберёт
# другой набор версий.
package-lock.json
yarn.lock

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store
# Windows создаёт их сам в любой открытой в проводнике папке.
Thumbs.db
desktop.ini

# Tests
/coverage
/.nyc_output

# Local architecture reports
/graphify-out/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Спека OpenAPI — артефакт генерации (pnpm gen:openapi).
# Коммитится копия в ne-malika-client/openapi/, откуда её читает orval.
/openapi
